# ==============================================================================
# SFIC Healthcare Navigation Platform Environment Configuration
# Swasth & Samavesh Bharat - Level 3
# ==============================================================================

# Product Identity (options: MediFlow | Healix | ResQ 2.0)
NEXT_PUBLIC_APP_NAME=HealX
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API / Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
DATA_STORE_MODE=auto

# AI Navigation Waterfall Service
# Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=
# Grok (xAI) API Key: https://console.x.ai/
GROK_API_KEY=

# AI Provider Waterfall Configuration
AI_MODE=enabled
AI_PROVIDER_ORDER=gemini,grok
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES_PER_PROVIDER=1
AI_MAX_OUTPUT_TOKENS=800

# SMS & Notification Service (options: mock | real)
SMS_MODE=mock
IVR_MODE=mock

# Twilio Optional Telephony Credentials (only required if SMS_MODE=real or IVR_MODE=real)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps Navigation Mode (options: links)
GOOGLE_MAPS_MODE=links
